{
  "skill_id": "vtskit",
  "id": "vtskit",
  "version": "0.4.1",
  "contract_version": "1.0",
  "provides": [
    {
      "id": "dvd.titleset",
      "lifecycle": "EXPERIMENTAL",
      "tool_id": "vtskit/titleset"
    },
    {
      "id": "dvd.video_manager",
      "lifecycle": "EXPERIMENTAL",
      "tool_id": "vtskit/vmg"
    },
    {
      "id": "dvd.subtitles",
      "lifecycle": "EXPERIMENTAL",
      "tool_id": "vtskit/subtitles"
    },
    {
      "id": "dvd.bitrate_plan",
      "lifecycle": "EXPERIMENTAL",
      "tool_id": "vtskit/plan"
    }
  ],
  "dependencies": [],
  "external_tools": [],
  "not_provided": [
    "encoding the MPEG-2 program streams (ffmpeg, oncemore)",
    "disc images (udfkit)",
    "burning a disc",
    "a command line beyond this contract (the kit is a Python library)",
    "network access of any kind"
  ],
  "tools": [
    {
      "tool_id": "vtskit/titleset",
      "kind": "python",
      "python": "vtskit.titleset.write",
      "writes_media": true,
      "mutates_input": false,
      "description": "Write a titleset (title and menu VOBs with filled navigation packs, VTS_nn_0.IFO and .BUP) into a VIDEO_TS folder"
    },
    {
      "tool_id": "vtskit/vmg",
      "kind": "python",
      "python": "vtskit.vmg.write",
      "writes_media": true,
      "mutates_input": false,
      "description": "Write the video manager (VIDEO_TS.IFO, .BUP and the title menu's VOB)"
    },
    {
      "tool_id": "vtskit/subtitles",
      "kind": "python",
      "python": "vtskit.subtitles.mux",
      "writes_media": true,
      "mutates_input": false,
      "description": "Add subpicture subtitle streams to a title's program stream, as spumux does"
    },
    {
      "tool_id": "vtskit/plan",
      "kind": "python",
      "python": "vtskit.plan.plan",
      "writes_media": false,
      "mutates_input": false,
      "description": "Plan a long programme's video bitrate on DVD-5 or DVD-9 against a quality floor (or report the shortfall), with a chapter a session from a chapter list"
    }
  ],
  "python_api": "vtskit.titleset, vtskit.vmg, vtskit.subtitles, vtskit.lang, vtskit.ifo, vtskit.plan",
  "execution": {
    "canonical_invocation": [
      "python",
      "-m",
      "vtskit",
      "contract",
      "--json"
    ],
    "network": false,
    "shell": false
  }
}
